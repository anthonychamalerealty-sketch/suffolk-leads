# Suffolk Leads — Environment Variables
# Copy this file to .env and fill in your actual values.
# Never commit the .env file to version control.

# ── Database ──────────────────────────────────────────────────────────────────
# Choose ONE of the three options below:
#
# Option A — PostgreSQL (recommended for Railway production):
#   DATABASE_URL=postgresql://user:password@host:5432/suffolk_leads
#
# Option B — SQLite with a Railway persistent volume mounted at /data:
#   DATABASE_PATH=/data/sql_app.db
#   (Leave DATABASE_URL unset; the scripts will build the URL automatically.)
#
# Option C — SQLite at a custom absolute path:
#   DATABASE_URL=sqlite:////absolute/path/to/sql_app.db
#
# If neither is set, the scripts will create a fresh SQLite DB at
# <project_root>/sql_app.db on each run (data won't persist between Railway
# cron runs unless you use Option A or B).
DATABASE_URL=postgresql://user:password@host:5432/suffolk_leads
# DATABASE_PATH=/data/sql_app.db

# ── Contact Enrichment ────────────────────────────────────────────────────────
# NumVerify API key — free tier: 250 phone validations / month
# https://numverify.com/
NUMVERIFY_API_KEY=your_numverify_api_key_here

# Hunter.io API key — free tier: 25 email lookups / month
# https://hunter.io/
HUNTER_API_KEY=your_hunter_api_key_here

# ── Email Delivery ────────────────────────────────────────────────────────────
# SendGrid API key — used by jobs/daily_digest.py to send the daily email digest
# https://sendgrid.com/
SENDGRID_API_KEY=your_sendgrid_api_key_here

# Recipient email address for the daily lead digest
DIGEST_EMAIL=Anthonychamalerealty@gmail.com
